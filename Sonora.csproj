<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Sonora</AssemblyName>
    <RootNamespace>Sonora</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Bajo consumo: GC de estación de trabajo, sin GC concurrente (un hilo menos), heap compacto -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <ApplicationIcon>assets\sonora.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <!-- Solo el lector de Media Foundation (decodificador nativo de Windows) para analizar BPM/tonalidad -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- DPAPI: cifra las credenciales de Last.fm con la cuenta de Windows -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- GC: prioriza ocupar poca memoria (compacta más el heap) -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
